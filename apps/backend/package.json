{
  "name": "backend-service",
  "version": "1.0.0",
  "private": true,
  "description": "Backend service for AmberOps",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc",
